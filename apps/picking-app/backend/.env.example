# Server
PORT=3001

# API Key security
# You can use one key or several separated by commas.
API_KEY=replace-with-strong-key
API_KEYS=

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=secret
MYSQL_DATABASE=warehouse

# Firebird
FB_HOST=127.0.0.1
FB_PORT=3050
FB_DATABASE=/path/to/database.gdb
FB_USER=SYSDBA
FB_PASSWORD=masterkey

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=warehouse

# SQL Server
MSSQL_HOST=127.0.0.1\\SQLEXPRESS
MSSQL_PORT=1433
MSSQL_USER=sa
MSSQL_PASSWORD=secret
MSSQL_DATABASE=warehouse

# PostgreSQL
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=secret
PG_DATABASE=warehouse
